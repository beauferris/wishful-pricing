{% comment %}
  Storefront pricing JSON. Reads shop.metafields.wishful (theme-safe), then app namespace.
  {% render 'wishful-pricing-config', product: product %}
{% endcomment %}

{% liquid
  assign wishful_catalog = null
  assign wishful_product_cfg = null

  assign wishful_app_catalog = shop.metafields.app.pricing_catalog.value
  if wishful_app_catalog == blank
    assign wishful_app_catalog = shop.metafields['$app'].pricing_catalog.value
  endif

  assign wishful_app_product_cfg = product.metafields.app.pricing_config.value
  if wishful_app_product_cfg == blank
    assign wishful_app_product_cfg = product.metafields['$app'].pricing_config.value
  endif

  if wishful_app_catalog != blank
    assign wishful_catalog = wishful_app_catalog
  elsif shop.metafields.wishful.pricing_catalog.value != blank
    assign wishful_catalog = shop.metafields.wishful.pricing_catalog.value
  endif

  if wishful_app_product_cfg != blank
    assign wishful_product_cfg = wishful_app_product_cfg
  elsif product.metafields.wishful.pricing_config.value != blank
    assign wishful_product_cfg = product.metafields.wishful.pricing_config.value
  endif

  assign wishful_pid = product.id | append: ''
  assign wishful_gid = 'gid://shopify/Product/' | append: wishful_pid
  assign wishful_in_catalog = false
  assign wishful_account_tier = ''
  assign wishful_customer_tags_json = '[]'
  assign wishful_cart_account_tier = ''

  if customer
    if customer.metafields.wishful.account_tier.value != blank
      assign wishful_account_tier = customer.metafields.wishful.account_tier.value
    endif
    assign wishful_customer_tags_json = customer.tags | json
  endif

  if cart.attributes.wishful_account_tier != blank
    assign wishful_cart_account_tier = cart.attributes.wishful_account_tier
  endif

  assign wishful_cfg_entry = null
  if wishful_catalog != blank
    assign wishful_cfg_entry = wishful_catalog[wishful_pid]
    if wishful_cfg_entry == blank
      assign wishful_cfg_entry = wishful_catalog[wishful_gid]
    endif
    if wishful_cfg_entry != blank
      assign wishful_in_catalog = true
    endif
  endif
  if wishful_cfg_entry == blank and wishful_product_cfg != blank
    assign wishful_cfg_entry = wishful_product_cfg
  endif
%}

<script type="application/json" id="wishful-pricing-config" data-product-id="{{ product.id }}">
  {%- if wishful_cfg_entry != blank -%}
    {{- wishful_cfg_entry | json -}}
  {%- else -%}
    null
  {%- endif -%}
</script>

<script type="application/json" id="wishful-pricing-catalog">
  {%- if wishful_catalog != blank -%}
    {{- wishful_catalog | json -}}
  {%- else -%}
    {}
  {%- endif -%}
</script>

<script>
  window.WISHFUL_ACCOUNT_TIER = {{ wishful_account_tier | json }};
  window.WISHFUL_CUSTOMER_TAGS = {{ wishful_customer_tags_json }};
  window.WISHFUL_CART_ACCOUNT_TIER = {{ wishful_cart_account_tier | json }};
  window.WISHFUL_SHOP_CURRENCY = {{ cart.currency.iso_code | default: shop.currency | json }};
</script>
<script src="{{ 'wishful-volume-tier-table.js' | asset_url }}" defer></script>

<script>
  window.wishfulWhenVolumeTableReady = function (fn) {
    if (typeof fn !== 'function') return;
    if (window.WishfulVolumeTable) {
      fn();
      return;
    }
    var attempts = 0;
    (function wait() {
      if (window.WishfulVolumeTable) {
        fn();
        return;
      }
      if (++attempts < 120) {
        requestAnimationFrame(wait);
      }
    })();
  };

  /** Form id attribute — never use form.id (conflicts with input name="id" on product forms). */
  window.wishfulFormElementId = function (form) {
    if (!form || !form.getAttribute) return '';
    return String(form.getAttribute('id') || '');
  };

  /** Match real add-to-cart form id (e.g. product-form-template--22463579455577__main). */
  window.wishfulSyncFormId = function () {
    var root = document.querySelector('[data-wishful-pricing-root]');
    var form = document.querySelector('form[action*="/cart/add"]');
    var attrId =
      (typeof window.wishfulFormElementId === 'function' &&
        window.wishfulFormElementId(form)) ||
      '';
    if (root && attrId) {
      root.setAttribute('data-wishful-form-id', attrId);
      return attrId;
    }
    return (root && root.getAttribute('data-wishful-form-id')) || '';
  };

  window.wishfulGetFormId = function () {
    var synced = window.wishfulSyncFormId();
    if (synced) return synced;
    var root = document.querySelector('[data-wishful-pricing-root]');
    return (root && root.getAttribute('data-wishful-form-id')) || '';
  };

  window.wishfulGetCartForm = function () {
    var form = document.querySelector('form[action*="/cart/add"]');
    if (form) {
      window.wishfulSyncFormId();
      return form;
    }
    var formId = window.wishfulGetFormId();
    if (formId) {
      var byId = document.getElementById(formId);
      if (byId && byId.tagName === 'FORM') return byId;
    }
    return null;
  };

  /** Inputs may live outside the form when using a theme app block (form="..." attribute). */
  window.wishfulQueryInForm = function (form, selector) {
    if (!form) form = window.wishfulGetCartForm();
    if (!form) return document.querySelector(selector);

    var el = form.querySelector(selector);
    if (el) return el;

    var formId =
      window.wishfulGetFormId() ||
      (typeof window.wishfulFormElementId === 'function' &&
        window.wishfulFormElementId(form)) ||
      '';
    if (formId) {
      el = document.querySelector(selector + '[form="' + formId + '"]');
      if (el) return el;
    }

    return document.querySelector(selector);
  };

  /** Match metafield, customer tag, or cart attribute to a tier key (case-insensitive). */
  window.wishfulFindAccountTierKey = function (tiers) {
    if (!tiers || typeof tiers !== 'object') return null;
    var tierKeys = Object.keys(tiers);
    if (!tierKeys.length) return null;

    function matchKey(candidate) {
      var raw = String(candidate || '').trim();
      if (!raw) return null;
      if (tiers[raw]) return raw;
      var lower = raw.toLowerCase();
      for (var i = 0; i < tierKeys.length; i++) {
        if (tierKeys[i].toLowerCase() === lower) return tierKeys[i];
      }
      return null;
    }

    var fromMeta = matchKey(window.WISHFUL_ACCOUNT_TIER);
    if (fromMeta) return fromMeta;

    var fromCart = matchKey(window.WISHFUL_CART_ACCOUNT_TIER);
    if (fromCart) return fromCart;

    var tags = window.WISHFUL_CUSTOMER_TAGS;
    if (Array.isArray(tags)) {
      for (var t = 0; t < tags.length; t++) {
        var hit = matchKey(tags[t]);
        if (hit) return hit;
      }
    }
    return null;
  };

  function wishfulScaleRateValue(rate, factor) {
    var n = Number(rate);
    if (!Number.isFinite(n)) return 0;
    return Math.round(n * factor * 100) / 100;
  }

  function wishfulScaleRatesMatrix(matrix, factor) {
    if (!Array.isArray(matrix)) return matrix;
    return matrix.map(function (row) {
      if (Array.isArray(row)) {
        return row.map(function (cell) {
          return wishfulScaleRateValue(cell, factor);
        });
      }
      return [wishfulScaleRateValue(row, factor)];
    });
  }

  function wishfulScaleRatesByVariant(map, factor) {
    if (!map || typeof map !== 'object') return {};
    var out = {};
    Object.keys(map).forEach(function (id) {
      var entry = map[id];
      if (!Array.isArray(entry)) return;
      if (entry.length > 0 && Array.isArray(entry[0])) {
        out[id] = wishfulScaleRatesMatrix(entry, factor);
      } else {
        out[id] = entry.map(function (n) {
          return wishfulScaleRateValue(n, factor);
        });
      }
    });
    return out;
  }

  function wishfulAccountTierPercentOff(tier) {
    if (!tier || typeof tier !== 'object') return 0;
    var pct = Number(
      tier.percentOff != null
        ? tier.percentOff
        : tier.discountPercent != null
          ? tier.discountPercent
          : tier.percent != null
            ? tier.percent
            : 0,
    );
    if (!Number.isFinite(pct)) return 0;
    return Math.min(100, Math.max(0, pct));
  }

  window.wishfulApplyAccountTier = function (cfg) {
    if (!cfg || !cfg.accountTiers || typeof cfg.accountTiers !== 'object') {
      return cfg;
    }
    var tiers = cfg.accountTiers;
    var tierKey = window.wishfulFindAccountTierKey(tiers);
    if (!tierKey || !tiers[tierKey]) return cfg;
    var percent = wishfulAccountTierPercentOff(tiers[tierKey]);
    if (percent <= 0) return cfg;
    var factor = 1 - percent / 100;
    return Object.assign({}, cfg, {
      rates: wishfulScaleRatesMatrix(cfg.rates, factor),
      ratesByVariant: wishfulScaleRatesByVariant(cfg.ratesByVariant, factor),
      accountTiers: cfg.accountTiers,
      wishfulActiveAccountTier: tierKey,
      wishfulAccountPercentOff: percent,
    });
  };

  window.wishfulReadPricingConfig = function () {
    var productId = String(
      (document.getElementById('wishful-pricing-config') || {}).dataset
        .productId || '',
    );

    function parseJson(raw) {
      if (raw == null || raw === '') return null;
      var text = String(raw).trim();
      var data = JSON.parse(text);
      if (typeof data === 'string') data = JSON.parse(data);
      return data;
    }

    var catalogEl = document.getElementById('wishful-pricing-catalog');
    if (catalogEl && productId) {
      try {
        var catalog = parseJson(catalogEl.textContent) || {};
        var fromCatalog =
          catalog[productId] ||
          catalog['gid://shopify/Product/' + productId];
        if (fromCatalog && typeof fromCatalog === 'object') {
          return window.wishfulApplyAccountTier(fromCatalog);
        }
      } catch (e) {
        console.warn('[wishful-pricing] catalog parse failed', e);
      }
    }

    var el = document.getElementById('wishful-pricing-config');
    if (!el) return null;

    try {
      var cfg = parseJson(el.textContent);
      if (cfg && typeof cfg === 'object') {
        return window.wishfulApplyAccountTier(cfg);
      }
      return null;
    } catch (e) {
      console.warn('[wishful-pricing] product config parse failed', e);
      return null;
    }
  };

  window.wishfulPersistAccountTier = function (tierKey) {
    var key = String(tierKey || '').trim();
    if (!key) return;
    window.WISHFUL_ACCOUNT_TIER = key;
    try {
      sessionStorage.setItem('wishful_account_tier', key);
    } catch (e) {}
    document.dispatchEvent(
      new CustomEvent('wishful:account-tier', { detail: { tierKey: key } }),
    );
  };

  /** Tier key for checkout (catalog, tags, session). */
  window.wishfulResolveAccountTierKey = function () {
    var stored = '';
    try {
      stored = sessionStorage.getItem('wishful_account_tier') || '';
    } catch (e) {}
    if (stored.trim()) return stored.trim();

    var catalogEl = document.getElementById('wishful-pricing-catalog');
    if (catalogEl) {
      try {
        var catalog = JSON.parse(catalogEl.textContent || '{}');
        var keys = catalog.__wishfulAccountTierKeys;
        if (Array.isArray(keys) && keys.length) {
          var index = {};
          keys.forEach(function (k) {
            index[k] = {};
          });
          var fromKeys = window.wishfulFindAccountTierKey(index);
          if (fromKeys) return fromKeys;
        }
        var configEl = document.getElementById('wishful-pricing-config');
        var productId = configEl
          ? String(configEl.dataset.productId || '')
          : '';
        if (productId) {
          var entry =
            catalog[productId] ||
            catalog['gid://shopify/Product/' + productId];
          if (entry && entry.accountTiers) {
            var fromEntry = window.wishfulFindAccountTierKey(entry.accountTiers);
            if (fromEntry) return fromEntry;
          }
        }
      } catch (e) {
        console.warn('[wishful-pricing] tier resolve failed', e);
      }
    }

    var fromLiquid = String(window.WISHFUL_ACCOUNT_TIER || '').trim();
    return fromLiquid || null;
  };

  /** Write wishful_account_tier cart attribute (discount function reads this at checkout). */
  window.wishfulEnsureCartAccountTier = function () {
    var tierKey = window.wishfulResolveAccountTierKey();
    if (!tierKey || typeof fetch !== 'function') {
      return Promise.resolve();
    }

    window.wishfulPersistAccountTier(tierKey);

    return fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        attributes: { wishful_account_tier: tierKey },
      }),
    })
      .then(function (res) {
        return res.json();
      })
      .catch(function (err) {
        console.warn('[wishful-pricing] cart tier attribute failed', err);
      });
  };

  window.wishfulSyncAccountTierToCart = function () {
    window.wishfulEnsureCartAccountTier();
  };

  window.wishfulSyncAccountTierToCart();
</script>
